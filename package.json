{
  "name": "lowcode",
  "version": "0.0.1",
  "private": true,
  "description": "In the beginning was the Great Origin the Way arose from the One dividing heaven and earth forming all things.",
  "workspace": true,
  "workspaces": [
    "packages/*",
    "src/api/*",
    "src/web/*"
  ],
  "scripts": {
    "start": "cross-env NODE_ENV=development ts-node src/api/lowcode-api/index.ts",
    "dev:web": "cross-env NODE_ENV=development NODE_MODE=webonly ts-node src/api/lowcode-api/index.webonly.ts",
    "mock": "cross-env NODE_ENV=development NODE_MODE=mock ts-node src/api/lowcode-api/index.ts",
    "db:migrate": "ts-node src/api/lowcode-api/migrate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.strict.json",
    "test": "cross-env NODE_ENV=test node --test --require ts-node/register --require tsconfig-paths/register \"test/**/*.test.ts\"",
    "lint": "eslint \"{src,packages/*/src,test}/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "build": "npm run typecheck && rm -rf dist && npm run build:api && npm run build:web",
    "build:api": "npm run build -w lowcode-server -w lowcode-dev-proxy && tsc -p src/api/tsconfig.build.json --outDir dist/src/api",
    "build:web": "cross-env NODE_ENV=production webpack -c build/webpack.js"
  },
  "keywords": [
    "lowcode"
  ],
  "peerDependencies": {
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-import": "^1.13.8",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-config-google": "0.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-webpack-plugin": "^6.0.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.19.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-middleware": "^8.3.0",
    "webpack-hot-middleware": "^2.26.1",
    "workbox-webpack-plugin": "^7.4.1"
  },
  "dependencies": {
    "@loadable/component": "^5.16.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@rematch/core": "2.2.0",
    "ace-builds": "^1.44.0",
    "ace-diff": "^3.3.0",
    "clsx": "^2.1.1",
    "core-js": "3.50.0",
    "dompurify": "^3.4.16",
    "history": "^5.3.0",
    "lucide-react": "^1.48.0",
    "moment": "^2.31.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-ace": "^14.1.0",
    "react-color": "2.19.3",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "workbox-precaching": "^7.4.1"
  },
  "license": "MIT",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
