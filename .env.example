# Environment variables read by the server. The app does not load .env files
# itself: export them in your shell, or set them in the container / ECS task
# definition. Values here are examples, not defaults.

# --- Sign-in (required outside development) ---------------------------------
# Admin password for the studio (/admin, /design) and its API.
ADMIN_PASSWORD=change-me
# Optional: signs session cookies. Without it the key is derived from
# ADMIN_PASSWORD, so changing the password signs everyone out.
SESSION_SECRET=
# Behind a load balancer: hops to trust for the client IP (login and upload
# rate limits are per client). E.g. 1 for a single ALB.
TRUST_PROXY=

# --- Runtime -------------------------------------------------------------------
# dev | test | pre | prod. Picks the Nacos namespace and keeps pre-release data
# apart from production. Defaults to `dev` in development.
RUN_ENV=
PORT=8080
# Where uploads and published configs are stored (served at /resources).
# Mount a volume here in containers. Default: ./appdata
APPDATA_DIR=
# Allow credentialed CORS from this domain and its subdomains (e.g. the other
# environments' studios). Default: localhost only.
CORS_ALLOW_DOMAIN=

# --- Database ------------------------------------------------------------------
# Production gets these from Nacos (lowcode-config.json). In development
# without NACOS_URL, and for `npm run db:migrate`, they are read from here.
NACOS_URL=
DB_URL=mysql://localhost:3306/lowcode
DB_USER=lowcode
DB_PASSWORD=lowcode

# --- Development only ----------------------------------------------------------
# Forward unmatched API requests to this upstream (npm run dev:web).
PROXY_TARGET=
